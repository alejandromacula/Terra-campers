# ESP32-S3R8 has 8MB of octal-SPI PSRAM integrated in the chip package.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

# Recording buffers live in PSRAM (fine for a few seconds of 16kHz/16-bit audio).
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024

# TLS for the HTTPS calls to Groq / ElevenLabs.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

# Give the HTTP/audio pipeline task enough stack.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
